+  const lines = [`Only Chat 자체 QA · ${labels[run.status] || run.status}`, `범위: ${run.purpose || '앱 내부 점검'}`];
+  for (const check of (run.checks || [])) lines.push(`- ${check.title}: ${check.status === 'passed' ? '통과' : '실패'}`);
+  return lines.join('\n');
+}
