-    stage.style.display = 'flex';
-    stage.style.visibility = 'hidden';
-    stage.style.pointerEvents = 'none';
-    const stageRect = stage.getBoundingClientRect();
-    const layoutRect = layout.getBoundingClientRect();
-    const withinOnePixel = (a, b) => Math.abs(a - b) <= 1;
-    const coversApp = withinOnePixel(stageRect.left, layoutRect.left)
-      && withinOnePixel(stageRect.top, layoutRect.top)
-      && withinOnePixel(stageRect.width, layoutRect.width)
