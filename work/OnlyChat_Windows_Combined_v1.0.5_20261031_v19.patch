+async function recordSettingsBoundsCheck(runId) {
+  const stage = document.getElementById('settingsStage');
+  const layout = document.querySelector('.app-layout');
+  if (!stage || !layout) return;
+  const original = {
+    display: stage.style.display,
+    visibility: stage.style.visibility,
+    pointerEvents: stage.style.pointerEvents
+  };
+  let status = 'failed';
+  try {
+    stage.style.display = 'flex';
+    stage.style.visibility = 'hidden';
+    stage.style.pointerEvents = 'none';
+    const stageRect = stage.getBoundingClientRect();
+    const layoutRect = layout.getBoundingClientRect();
+    const withinOnePixel = (a, b) => Math.abs(a - b) <= 1;
+    const coversApp = withinOnePixel(stageRect.left, layoutRect.left)
+      && withinOnePixel(stageRect.top, layoutRect.top)
+      && withinOnePixel(stageRect.width, layoutRect.width)
+      && withinOnePixel(stageRect.height, layoutRect.height);
+    status = coversApp ? 'passed' : 'failed';
+  } catch (_) {
+    status = 'failed';
+  } finally {
+    stage.style.display = original.display;
+    stage.style.visibility = original.visibility;
+    stage.style.pointerEvents = original.pointerEvents;
+  }
+  try {
+    await fetch(`/api/qa/runs/${encodeURIComponent(runId)}/client-check`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ checkId: 'settings-bounds', status })
+    });
+  } catch (_) {}
+}
+
+function formatQARun(run) {
