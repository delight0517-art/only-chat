+
+let currentFilter = 'all'; // 'all', 'codex', 'antigravity', 'claude-code', 'internal'
+let cachedUnifiedData = null;
+let sessionSearchQuery = '';
+let sessionSearchResults = null;
+let sessionSearchRequestId = 0;
+let sessionSearchTimer = null;
