+  if (currentFilter === 'codex' || currentFilter === 'antigravity' || currentFilter === 'claude-code') {
+    results = results.filter(session => session.source === currentFilter);
+  } else if (currentFilter === 'internal') {
+    results = [];
+  }
+  if (results.length === 0) {
