+      card.currentWorkStep = null;
+      setAssistantWorkStatus(card, failed ? '단계 실패 · 결과를 확인해 주세요' : '다음 작업 단계를 준비하고 있습니다…');
+      timeline.scrollTop = timeline.scrollHeight;
+      break;
+    }
+    case 'error': {
+      card.workOutcome = 'error';
+      setAssistantWorkStatus(card, '응답을 완료하지 못했습니다');
+      const failure = document.createElement('div');
+      failure.className = 'text-body';
+      failure.textContent = `❌ AI 응답을 받지 못했습니다.\n${event.message || '오류 원인을 확인할 수 없습니다.'}`;
+      card.content.appendChild(failure);
+      timeline.scrollTop = timeline.scrollHeight;
+      break;
+    }
+  }
+}
