+      const state = step?.querySelector('.assistant-work-step-state');
+      if (state) {
+        state.textContent = commandResultUnknown ? '결과 확인 불가' : failed ? `실패${result.exitCode === undefined || result.exitCode === null ? '' : ` · 종료 코드 ${result.exitCode}`}` : '완료';
