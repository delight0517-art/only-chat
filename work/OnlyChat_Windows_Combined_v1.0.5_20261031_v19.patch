+  const action = /(?:qa|테스트|검사|점검|버그|오류 확인)/i.test(text);
+  const target = /(?:프로그램\s*선생님|소프트웨어\s*선생님|software\s*tutor|3d\s*teacher|(?:앱|프로그램|게임))/i.test(text);
+  return action && target;
