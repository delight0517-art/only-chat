-function rememberAppView(view) {
-  if (applyingAppViewHistory) return;
-  const current = appViewHistory[appViewHistoryIndex];
-  if (current?.view === view.view && current?.tab === view.tab) return;
-  appViewHistory = appViewHistory.slice(0, appViewHistoryIndex + 1);
-  appViewHistory.push(view);
-  appViewHistoryIndex = appViewHistory.length - 1;
-  updateAppViewNavigation();
-}
-
-function updateAppViewNavigation() {
-  const back = document.getElementById('btnNavBack');
-  const forward = document.getElementById('btnNavForward');
-  if (back) back.disabled = appViewHistoryIndex <= 0;
-  if (forward) forward.disabled = appViewHistoryIndex >= appViewHistory.length - 1;
-}
-
-function moveAppViewHistory(direction) {
-  const nextIndex = appViewHistoryIndex + direction;
-  if (nextIndex < 0 || nextIndex >= appViewHistory.length) return;
-  appViewHistoryIndex = nextIndex;
-  const view = appViewHistory[nextIndex];
-  applyingAppViewHistory = true;
-  try {
-    if (view.view === 'settings') openSettingsStage(view.tab || 'general');
-    else closeSettingsStage();
-  } finally {
-    applyingAppViewHistory = false;
-    updateAppViewNavigation();
-  }
-}
