-async function handleSend() {
-  if (readOnlyExternalSession) return;
-  const prompt = composerInput.value.trim();
-  if (!prompt || isGenerating) return;
-
-  // Clear input & reset height
-  composerInput.value = '';
-  composerInput.style.height = 'auto';
-
-  if (emptyState) emptyState.style.display = 'none';
-
-  // Set generating state & update Orange Button (Ref 3)
-  setGeneratingState(true);
-
-  // Update Titlebar
-  titlebarThreadTitle.textContent = prompt.length > 35 ? prompt.slice(0, 35) + '...' : prompt;
-
-  // Append User message
-  appendUserMessage(prompt);
-
-  // Create Assistant Message container (Warm Peach Card - Ref 1 & 2)
-  const assistantCard = createAssistantContainer();
-  timeline.appendChild(assistantCard.row);
-  timeline.scrollTop = timeline.scrollHeight;
-
-  currentAbortController = new AbortController();
-
-  try {
-    let qaRoute = null;
-    try {
-      const routeResponse = await fetch('/api/qa/chat-route', {
-        method: 'POST', headers: { 'Content-Type': 'application/json' },
-        body: JSON.stringify({ prompt, sessionId: currentSessionId }),
-        signal: currentAbortController.signal
-      });
-      qaRoute = await routeResponse.json();
-      if (!routeResponse.ok) throw new Error(qaRoute.error || `HTTP ${routeResponse.status}`);
-    } catch (routeError) {
-      if (isLikelyQARequest(prompt)) throw new Error(`QA 요청을 전달하지 못했습니다: ${routeError.message}`);
-    }
-    if (qaRoute?.route === 'qa') {
-      renderQAChatRequest(assistantCard.content, qaRoute.request);
-      await saveQAChatNote(`프로그램 선생님 QA 요청 · ${qaRoute.request.status}\n요청: ${qaRoute.request.prompt}`);
-      await refreshQAChatRequests();
-      currentAbortController = null;
-      setGeneratingState(false);
-      return;
-    }
-
-    const res = await fetch('/api/turn', {
-      method: 'POST',
-      headers: { 'Content-Type': 'application/json' },
-      body: JSON.stringify({
-        sessionId: currentSessionId,
-        prompt,
-        overrideTierId: activeTier?.id,
-        sandboxPolicy: document.getElementById('accessPolicy').value
-      }),
-      signal: currentAbortController.signal
-    });
-
-    const reader = res.body.getReader();
-    const decoder = new TextDecoder();
-    let buffer = '';
-
-    while (true) {
-      const { done, value } = await reader.read();
-      if (done) break;
-      buffer += decoder.decode(value, { stream: true });
-
-      const lines = buffer.split('\n');
-      buffer = lines.pop();
-
-      for (const line of lines) {
-        if (!line.startsWith('data: ')) continue;
-        const jsonStr = line.replace('data: ', '').trim();
-        if (jsonStr === '[DONE]') break;
-
-        try {
-          const event = JSON.parse(jsonStr);
-          handleStreamEvent(event, assistantCard);
-        } catch (_) {}
-      }
-    }
-
-    await refreshPriorityStatus();
-    await loadSessions();
-
-  } catch (err) {
-    if (err.name === 'AbortError') {
-      assistantCard.bubble.innerHTML += `<div style="color: var(--accent-orange); margin-top: 8px; font-size: 12px;">⏹ 사용자에 의해 작업이 즉시 중단되었습니다.</div>`;
-    } else {
-      assistantCard.bubble.innerHTML += `<div style="color: var(--accent-red); margin-top: 8px; font-size: 12px;">❌ 오류: ${err.message}</div>`;
-    }
-  } finally {
-    currentAbortController = null;
-    setGeneratingState(false);
-  }
-}
