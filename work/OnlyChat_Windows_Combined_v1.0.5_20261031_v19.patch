+function handleLiveMorphUpdate(event) {
+  const { organ, payload } = event;
+  if (organ === 'stylesheet') {
+    const old = document.querySelector('link[rel="stylesheet"]');
+    if (old) { const next=old.cloneNode(); next.href=`/app.css?sha256=${payload.hash}`; next.onload=()=>old.remove(); next.onerror=()=>next.remove(); old.after(next); }
+    return;
+  }
+  if (organ === 'module') {
+    const apply = async () => {
+      if (window.onlyChatGetModuleBlockers().length) { setTimeout(apply,300); return; }
+      try { const status=await window.OnlyChatRendererModules.reload(payload.id); showMorphToast(`${payload.id} · ${status.version} · 적용됨`); }
+      catch(error) { showMorphToast(`모듈 복구됨: ${error.message}`); }
+    };
+    apply(); return;
+  }
+  if (organ === 'restart-required') { showMorphToast(`${payload.file} 변경됨 · 핵심 코드 적용에는 앱 재시작이 필요합니다.`); return; }
+  showMorphToast(`⚡️ 신체 변형 적용됨: [${organ}] (v${event.slot?.version || 'new'})`);
+  const data = payload?.data;
+  if (data && currentMorphStatus) currentMorphStatus.organs[organ] = data;
+  if (payload?.key && currentMorphStatus?.organHashes) currentMorphStatus.organHashes[organ] = null;
+  applyMorphOrgans(currentMorphStatus?.organs);
+  refreshMorphStatus();
+}
