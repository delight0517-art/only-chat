+      if (data.ok && data.session && data.session.turns) {
+        const sourceLabel = data.session.source === 'codex' ? 'Codex' : data.session.source === 'antigravity' ? 'Antigravity' : 'Claude Code';
+        titlebarThreadTitle.textContent = `${data.session.title} (${sourceLabel}${data.session.readOnly ? ' · 읽기 전용' : ' 재개됨'})`;
