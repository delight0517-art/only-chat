+/* Only Chat (Codex Sovereign Edition) macOS Desktop Stylesheet */
+:root {
+  --bg-app: #ffffff;
+  --bg-sidebar: #f7f7f8;
+  --bg-rail: #f2f2f3;
+  --bg-card: #ffffff;
+  --bg-card-hover: #f4f4f5;
+  --bg-assistant-peach: #fbf2eb;
+  --border-peach: #f3e4d7;
+  
+  --border-subtle: #e5e7eb;
+  --border-focus: #f06a35;
+  
+  --text-main: #18181b;
+  --text-muted: #52525b;
+  --text-dim: #71717a;
+  
+  --accent-orange: #f06a35;
+  --accent-orange-hover: #e25822;
+  --accent-cyan: #0284c7;
+  --accent-green: #10b981;
+  --accent-red: #ef4444;
+
+  --font-sans: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", sans-serif;
+  --font-mono: "SF Mono", Menlo, Monaco, Consolas, monospace;
+  --titlebar-height: 44px;
+  --base-size: 13px;
+  --line-height: 1.6;
+  --sidebar-width: 240px;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+  -webkit-font-smoothing: antialiased;
+}
+
+body {
+  font-family: var(--font-sans);
+  font-size: var(--base-size);
+  line-height: var(--line-height);
+  background-color: var(--bg-app);
+  color: var(--text-main);
+  height: 100vh;
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+  user-select: none;
+}
+
+/* 1. macOS Titlebar */
+.mac-titlebar {
+  height: var(--titlebar-height);
+  background: var(--bg-sidebar);
+  border-bottom: 1px solid var(--border-subtle);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 0 16px 0 14px;
+  -webkit-app-region: drag;
+  z-index: 100;
+}
+
+.titlebar-left {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  -webkit-app-region: no-drag;
+}
+
+.traffic-lights {
+  display: flex;
+  gap: 8px;
+}
+
+.light {
+  width: 12px;
+  height: 12px;
+  border-radius: 50%;
+  cursor: pointer;
+}
+.light.red { background: #ff5f56; border: 1px solid #e0443e; }
+.light.yellow { background: #ffbd2e; border: 1px solid #dea123; }
+.light.green { background: #27c93f; border: 1px solid #1aab29; }
+
+.nav-arrows {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.nav-btn {
