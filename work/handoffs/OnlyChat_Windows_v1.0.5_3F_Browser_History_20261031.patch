+  async history(action) {
+    if (!this.window || this.window.isDestroyed()) return { ok: false, stderr: '브라우저가 열려 있지 않습니다.' };
+    const contents = this.window.webContents, h = contents.navigationHistory;
+    if (!h) return { ok: false, stderr: '브라우저 기록 API를 사용할 수 없습니다.' };
+    if (action === 'reload') {
+      const url = contents.getURL();
+      if (!/^https?:\/\//i.test(url)) return { ok: false, stderr: '현재 페이지를 다시 불러올 수 없습니다.' };
+      const decision = await this.policy.check(url);
+      if (!decision.allowed) return { ok: false, stderr: 'Focus Fence 정책이 허용하지 않아 다시 불러오지 않았습니다.', blocked: true };
+      contents.reload(); return { ok: true, url, stdout: '현재 페이지를 다시 불러옵니다.' };
+    }
+    if (!['back','forward'].includes(action)) return { ok: false, stderr: '지원 동작: back, forward, reload' };
+    if (!(action === 'back' ? h.canGoBack() : h.canGoForward())) return { ok: false, stderr: '이동할 기록이 없습니다.' };
+    const entry = h.getEntryAtIndex(h.getActiveIndex() + (action === 'back' ? -1 : 1));
+    if (!entry?.url || !/^https?:\/\//i.test(entry.url)) return { ok: false, stderr: '이 기록 항목은 열 수 없습니다.' };
+    const decision = await this.policy.check(entry.url);
+    if (!decision.allowed) return { ok: false, stderr: decision.reason === 'blocked' ? 'Focus Fence가 기록 이동을 차단했습니다.' : 'Focus Fence 정책 확인에 실패했습니다.', blocked: true };
+    this.approvedUrl = entry.url; h[action === 'back' ? 'goBack' : 'goForward']();
+    this.activeUrl = entry.url; this.lastError = '';
+    return { ok: true, url: entry.url, stdout: action === 'back' ? '이전 페이지로 이동했습니다.' : '다음 페이지로 이동했습니다.' };
+  }
