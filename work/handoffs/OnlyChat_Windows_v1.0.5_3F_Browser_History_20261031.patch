+window.handleBrowserHistory = async function(action) {
+  const el = document.getElementById('browserAriaConsole');
+  try {
+    const res = await fetch('/api/browser/history', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action }) });
+    const data = await res.json();
+    if (!res.ok || !data.ok) throw new Error(data.stderr || data.error || ('HTTP ' + res.status));
+    el.textContent = data.stdout || '완료';
+    if (data.url) document.getElementById('browserUrlInput').value = data.url;
+    setTimeout(() => handleBrowserAria(), 400);
+  } catch (error) { el.textContent = '[브라우저 기록 오류] ' + error.message; }
+};
