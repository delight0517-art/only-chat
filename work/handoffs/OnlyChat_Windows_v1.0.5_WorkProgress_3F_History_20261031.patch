+assert.match(card.workStepsNode.textContent, /\/workspace\/example/);
+assert.doesNotMatch(card.content.textContent, /private internal reasoning/);
+assert.match(source, /createAssistantContainer\(\{ timing: true \}\)/, 'new turns create the timed work card');
+assert.match(source, /const assistantTimer = startAssistantTimer\(assistantCard\)/, 'new turns start the elapsed timer');
+vm.runInContext("finishAssistantWork(card, 'complete')", context);
